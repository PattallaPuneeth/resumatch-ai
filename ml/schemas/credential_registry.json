{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resumatch.ai/schemas/credential_registry.json",
  "title": "ResuMatch credential registry",
  "description": "Authoritative, versioned list of credentials the engine can evaluate. Every entry needs provenance. The engine never verifies a credential with an issuer; it only interprets what the resume states.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "generated_at", "entries"],
  "properties": {
    "registry_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "generated_at": { "type": "string", "format": "date" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/credential" } }
  },
  "$defs": {
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "country"],
      "properties": {
        "scope": { "enum": ["international", "national", "subnational", "issuer_global"] },
        "country": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" },
        "subdivision": { "type": ["string", "null"], "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$" }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "match"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "match": { "enum": ["exact_ci", "exact_cs", "regex"] },
        "requires_context_terms": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "label", "ordinal", "in_pathway", "cue_patterns"],
      "properties": {
        "stage_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "label": { "type": "string" },
        "ordinal": { "type": "integer", "minimum": 0 },
        "in_pathway": { "type": "boolean", "description": "true: holder is progressing toward higher stages (lower stage -> Partial). false: lower stage is a different, lower credential (-> Not met)." },
        "cue_patterns": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "recognition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_jurisdiction", "to_jurisdiction", "mode", "source_url", "verified_as_of"],
      "properties": {
        "from_jurisdiction": { "$ref": "#/$defs/jurisdiction" },
        "to_jurisdiction": { "$ref": "#/$defs/jurisdiction" },
        "mode": { "enum": ["automatic", "administrative_transfer", "exam_required", "not_recognized", "unknown"] },
        "source_url": { "type": "string", "format": "uri" },
        "verified_as_of": { "type": "string", "format": "date" }
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential_id", "display_name", "aliases", "sector_ids", "issuing_body", "jurisdiction", "credential_kind", "stages", "validity", "recognition", "gate_policy", "provenance"],
      "properties": {
        "credential_id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "display_name": { "type": "string" },
        "aliases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/alias" } },
        "sector_ids": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 28 } },
        "driving_role": { "type": "boolean", "default": false },
        "issuing_body": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": { "name": { "type": "string" }, "url": { "type": "string", "format": "uri" } }
        },
        "jurisdiction": { "$ref": "#/$defs/jurisdiction" },
        "credential_kind": { "enum": ["statutory_licence", "statutory_registration", "professional_membership", "certificate_of_practice", "certification", "permit", "exam_pass"] },
        "stages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stage" } },
        "validity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "expiry_derivation"],
          "properties": {
            "type": { "enum": ["none", "fixed_term", "renewal_required", "unknown"] },
            "term_months": { "type": ["integer", "null"], "minimum": 1 },
            "expiry_derivation": { "enum": ["explicit_only", "derived_is_unknown_possibly_lapsed"] }
          }
        },
        "recognition": { "type": "array", "items": { "$ref": "#/$defs/recognition" } },
        "gate_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["when_jd_required", "unknown_policy"],
          "properties": {
            "when_jd_required": { "enum": ["mandatory_gate", "scored_only", "confirm_only"] },
            "unknown_policy": { "const": "exclude_and_confirm" }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_urls", "verified_as_of", "verified_by", "review_status"],
          "properties": {
            "source_urls": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } },
            "verified_as_of": { "type": "string", "format": "date" },
            "verified_by": { "type": "string" },
            "review_status": { "enum": ["draft", "owner_approved", "retired"] }
          }
        }
      }
    }
  }
}
