{
  "uid": "resumatch-usage-meters",
  "title": "ResuMatch: usage meters",
  "description": "Consumes (allowed or blocked), threshold crossings and refunds per meter, from the backend's OTel metrics. No user ids are recorded.",
  "tags": [
    "resumatch",
    "phase-10b"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Metered actions per second, by meter and outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (meter, outcome) (rate(resumatch_usage_consumed_total[$__rate_interval]))",
          "legendFormat": "{{meter}} {{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Share of metered actions blocked by a limit",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (meter) (rate(resumatch_usage_consumed_total{outcome=\"blocked\"}[$__rate_interval])) / sum by (meter) (rate(resumatch_usage_consumed_total[$__rate_interval]))",
          "legendFormat": "{{meter}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Threshold crossings (50/70/90/100% of a monthly meter) since the backend started",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (meter, threshold) (resumatch_usage_threshold_crossed_total)",
          "legendFormat": "{{meter}} {{threshold}}%"
        }
      ]
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Refunds by reason (selected range)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (meter, reason) (increase(resumatch_usage_refunds_total[$__range]))",
          "legendFormat": "{{meter}} {{reason}}"
        }
      ]
    }
  ]
}
