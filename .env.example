# ==========================================
# ResuMatch AI - Environment Configuration
# ==========================================

# Fastify Backend Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL + pgvector
POSTGRES_USER=resumatch_user
POSTGRES_PASSWORD=resumatch_password
POSTGRES_DB=resumatch_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://resumatch_user:resumatch_password@localhost:5432/resumatch_db?schema=public

# Redis & BullMQ Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# MinIO (S3 Compatible Object Storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=resumes

# Python ML Microservice (FastAPI)
ML_SERVICE_URL=http://localhost:8000
EMBEDDING_DIMENSION=384

# Frontend Client
VITE_API_URL=http://localhost:4000
