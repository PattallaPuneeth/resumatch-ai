# ==========================================
# ResuMatch AI - Environment Configuration
# ==========================================

# Fastify Backend Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# JWT Authentication (Phase 2B)
JWT_SECRET=local-dev-secret-change-in-production
RESUME_CAP_PER_USER=50

# PostgreSQL + pgvector
POSTGRES_USER=resumatch_user
POSTGRES_PASSWORD=resumatch_password
POSTGRES_DB=resumatch
POSTGRES_PORT=5432
DATABASE_URL=postgresql://resumatch_user:resumatch_password@localhost:5432/resumatch?schema=public

# Redis & BullMQ Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# S3-Compatible Object Storage (Phase 2A)
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=resumes
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=5242880
PRESIGN_PUT_TTL_SECONDS=300
PRESIGN_GET_TTL_SECONDS=300

# Legacy MinIO Compatibility
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=resumes

# Python ML Microservice (FastAPI)
ML_SERVICE_URL=http://localhost:8000
EMBEDDING_DIMENSION=384

# Internal Microservice Authentication (Phase 4B)
# Shared secret token for Node <-> ML internal communication. Must be at least 32 characters.
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=CHANGE_ME_GENERATE_RANDOM_AT_LEAST_32_CHARS

# Frontend Client
VITE_API_URL=http://localhost:4000

# Multi-Provider LLM Gateway (Phase 4A)
# Tier 1 - Google AI Studio: working model = gemini-3.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=
# Tier 2 - Groq Primary: working model = openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL_PRIMARY=
# Tier 3 - OpenRouter Free: working model = openrouter/free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Tier 4 - Groq Emergency: working model = openai/gpt-oss-20b
GROQ_MODEL_EMERGENCY=
