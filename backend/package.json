{
  "name": "resumatch-backend",
  "version": "1.0.0",
  "description": "Fastify backend service for ResuMatch AI",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/db/seed.ts"
  },
  "prisma": {
    "schema": "db/schema.prisma",
    "seed": "tsx src/db/seed.ts"
  },
  "keywords": [
    "resumatch",
    "ats",
    "fastify",
    "typescript",
    "prisma",
    "pgvector",
    "bullmq"
  ],
  "author": "ResuMatch AI Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.670.0",
    "@aws-sdk/s3-request-presigner": "^3.670.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/sensible": "^6.0.1",
    "@prisma/client": "5.22.0",
    "bullmq": "^5.28.4",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.1",
    "minio": "^8.0.2",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.8.7",
    "pino-pretty": "^13.0.0",
    "prisma": "5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@5.22.0": true
  }
}
