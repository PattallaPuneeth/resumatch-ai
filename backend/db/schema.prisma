datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model User {
  id            String         @id @default(uuid())
  email         String?        @unique
  passwordHash  String?
  fullName      String?
  role          String         @default("CANDIDATE")
  planKey       String         @default("unlimited")
  plan          Plan           @relation(fields: [planKey], references: [key])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  credential    Credential?
  sessions      Session[]
  recoveryCodes RecoveryCode[]
  resumes       Resume[]
  jobs          Job[]
  usages        UserUsage[]

  @@map("users")
}

enum ResumeStatus {
  UPLOAD_PENDING
  UPLOADED
  EXTRACTING
  NEEDS_OCR
  OCR_PROCESSING
  PARSED
  FAILED
}

enum ExtractionMethod {
  TEXT_LAYER
  OCR
  DOCX
}

model Resume {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalFilename String
  storageKey       String            @unique
  mimeType         String
  sizeBytes        Int
  sha256           String?
  extractionMethod ExtractionMethod?
  errorCode        String?
  errorMessage     String?
  status           ResumeStatus      @default(UPLOADED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  parsedResume     ParsedResume?
  chunks           ResumeChunk[]
  analyses         Analysis[]
  matches          Match[]

  @@index([userId])
  @@index([status])
  @@map("resumes")
}

model ParsedResume {
  id              String   @id @default(uuid())
  resumeId        String   @unique
  resume          Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  rawText         String   @db.Text
  candidateName   String?
  contactInfo     Json?
  summary         String?  @db.Text
  skills          Json?
  experience      Json?
  education       Json?
  certifications  Json?
  pageCount       Int?
  atsScore        Float?
  atsHazards      Json?
  parsingMetadata Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("parsed_resumes")
}

model ResumeChunk {
  id          String                     @id @default(uuid())
  resumeId    String
  resume      Resume                     @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  chunkIndex  Int
  sectionType String                     // EXPERIENCE, EDUCATION, SKILLS, SUMMARY, OTHER
  content     String                     @db.Text
  embedding   Unsupported("vector(384)")?
  tokenCount  Int?
  metadata    Json?
  createdAt   DateTime                   @default(now())

  @@unique([resumeId, chunkIndex])
  @@index([resumeId])
  @@map("resume_chunks")
}

model Job {
  id              String      @id @default(uuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  title           String
  company         String
  location        String?
  jobType         String?     // FULL_TIME, PART_TIME, CONTRACT, REMOTE
  rawDescription  String      @db.Text
  requiredSkills  Json?
  preferredSkills Json?
  experienceLevel String?
  status          String      @default("ACTIVE") // ACTIVE, ARCHIVED, DRAFT
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  chunks          JobChunk[]
  analyses        Analysis[]
  matches         Match[]

  @@index([userId])
  @@index([status])
  @@map("jobs")
}

model JobChunk {
  id          String                     @id @default(uuid())
  jobId       String
  job         Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  chunkIndex  Int
  sectionType String                     // RESPONSIBILITIES, QUALIFICATIONS, BENEFITS, OVERVIEW
  content     String                     @db.Text
  embedding   Unsupported("vector(384)")?
  tokenCount  Int?
  metadata    Json?
  createdAt   DateTime                   @default(now())

  @@unique([jobId, chunkIndex])
  @@index([jobId])
  @@map("job_chunks")
}

model Analysis {
  id                     String   @id @default(uuid())
  resumeId               String
  resume                 Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobId                  String?
  job                    Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  score                  Float?
  skillGap               Json?
  atsFindings            Json?
  bulletRewrites         Json?
  status                 String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  result                 Json?
  llmStatus              String?  // SUCCESS, UNAVAILABLE, FAILED
  provider               String?
  model                  String?
  promptVersion          String?
  tokensPrompt           Int?
  tokensCompletion       Int?
  latencyMs              Int?
  fabricatedEvidenceRate Float?
  injectionSuspected     Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([resumeId, jobId])
  @@index([resumeId])
  @@index([jobId])
  @@map("analyses")
}

model Match {
  id                String   @id @default(uuid())
  resumeId          String
  resume            Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobId             String
  job               Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  bm25Score         Float?
  vectorScore       Float?
  rrfScore          Float?
  crossEncoderScore Float?
  finalScore        Float
  explanation       Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([resumeId, jobId])
  @@index([resumeId])
  @@index([jobId])
  @@map("matches")
}

model Credential {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username      String
  usernameLower String   @unique
  passwordHash  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([usernameLower])
  @@map("credentials")
}

model Session {
  id           String    @id @default(uuid())
  familyId     String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  ipAddress    String?
  userAgent    String?

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
  @@map("sessions")
}

model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("recovery_codes")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  event      String?  // REGISTER, LOGIN_SUCCESS, LOGIN_FAILURE, LOCKOUT, REFRESH_REUSE_DETECTED, LOGOUT, LOGOUT_ALL, RECOVERY_USED, RECOVERY_CODES_REGENERATED, ACCOUNT_DELETED
  action     String   // RESUME_UPLOAD, RESUME_DELETE, ANALYSIS_TRIGGERED, JOB_CREATED, MATCH_CALCULATED, AUTH
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([event])
  @@index([createdAt])
  @@map("audit_logs")
}

model Plan {
  key       String   @id
  name      String
  limits    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@map("plans")
}

model UserUsage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meter     String
  period    String
  used      BigInt   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, meter, period])
  @@index([userId])
  @@map("user_usage")
}
