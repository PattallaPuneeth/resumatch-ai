    "/v1/jobs": {
      "post": {
        "summary": "Create a new job description and trigger embedding generation",
        "tags": [
          "Jobs"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "company": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "rawDescription": {
                    "type": "string",
                    "minLength": 20
                  },
                  "location": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "jobType": {
                    "type": "string",
                    "maxLength": 50
                  },
                  "requiredSkills": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "maxItems": 50
                  },
                  "preferredSkills": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "maxItems": 50
                  },
                  "experienceLevel": {
                    "type": "string",
                    "maxLength": 50
                  }
                },
                "required": [
                  "title",
                  "company",
                  "rawDescription"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "get": {
        "summary": "List user job descriptions (paginated)",
        "tags": [
          "Jobs"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            },
            "in": "query",
            "name": "limit",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "in": "query",
            "name": "offset",
            "required": false
          }
        ],
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
