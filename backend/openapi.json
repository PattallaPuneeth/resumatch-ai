    "/v1/resumes/upload-url": {
      "post": {
        "summary": "Request presigned S3 upload URL for resume document",
        "tags": [
          "Resumes"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "filename": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255,
                    "pattern": "\\.(pdf|docx)$"
                  },
                  "mimeType": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sizeBytes": {
                    "type": "integer",
                    "exclusiveMinimum": true,
                    "minimum": 0,
                    "maximum": 5242880
                  }
                },
                "required": [
                  "filename",
                  "mimeType",
                  "sizeBytes"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
